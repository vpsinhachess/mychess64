ADMIN_PASSWORD=choose-a-long-password      # required, 8+ chars
SESSION_SECRET=any-long-random-string      # keeps admin logins valid across restarts
DATA_DIR=/data                             # MUST point to a persistent disk/volume
PORT=3000
TRUST_PROXY_HOPS=1                        # 2 if Cloudflare sits in front of your host
SEED=1                                     # 0 = don't load sample data on first run
# Optional email alerts (also run: npm install nodemailer)
# SMTP_URL=smtps://user:app-password@smtp.gmail.com
# ADMIN_EMAIL=you@example.com
