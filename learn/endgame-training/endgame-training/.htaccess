# Apache config for MyChess64 Endgame Training. Replace mychess64.com with your domain.
AddType application/wasm .wasm
AddType text/javascript .js

# Hot-link protection: other sites cannot load your engine, puzzle data or scripts from your server.
RewriteEngine On
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?mychess64\.com/ [NC]
RewriteRule \.(js|wasm|css|png)$ - [F,NC]

Options -Indexes
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Content-Security-Policy "frame-ancestors 'self'; worker-src 'self'; script-src 'self' 'wasm-unsafe-eval'"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
